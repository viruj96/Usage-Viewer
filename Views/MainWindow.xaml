<Window x:Class="UsageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:UsageViewer"
        Title="{x:Static local:ViewerText.AppTitle}" Width="300" Height="190" MinWidth="300" MinHeight="190"
        MaxWidth="300" MaxHeight="190" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="Transparent" Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.WindowBackgroundBrush}" Color="#171A1F" Opacity="0.80" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.SurfaceBrush}" Color="#20252C" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.BorderBrush}" Color="#343B45" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.PrimaryTextBrush}" Color="#E7EAEE" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.SecondaryTextBrush}" Color="#98A2AE" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.PrimaryAccentBrush}" Color="#5B86B3" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.SecondaryAccentBrush}" Color="#4F8F8B" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.PrimaryUsageBarBrush}" Color="#C7F36B" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.SecondaryUsageBarBrush}" Color="#61E8D2" />
        <SolidColorBrush x:Key="{x:Static local:ViewerBrushKeys.WarningBrush}" Color="#C08A57" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryTextBrush}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource {x:Static local:ViewerBrushKeys.BorderBrush}}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryAccentBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414B58" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryAccentBrush}}" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#68727E" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="SignInButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryTextBrush}}" />
            <Setter Property="Background" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryAccentBrush}}" />
            <Setter Property="BorderBrush" Value="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryAccentBrush}}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>
    <Border Margin="4" Background="{StaticResource {x:Static local:ViewerBrushKeys.WindowBackgroundBrush}}" BorderBrush="{StaticResource {x:Static local:ViewerBrushKeys.BorderBrush}}" BorderThickness="1"
            CornerRadius="14" Padding="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static local:ViewerText.ProductName}" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource {x:Static local:ViewerBrushKeys.PrimaryTextBrush}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" ToolTip="{x:Static local:ViewerText.RefreshUsage}"
                            Automation:AutomationProperties.Name="{x:Static local:ViewerText.RefreshUsage}"
                            Style="{StaticResource QuietButtonStyle}" Click="RefreshButton_Click">
                        <TextBlock x:Name="RefreshGlyph" Text="{x:Static local:ViewerText.RefreshButton}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="HideButton" Content="{x:Static local:ViewerText.HideButton}" ToolTip="{x:Static local:ViewerText.HideToTray}"
                            Automation:AutomationProperties.Name="{x:Static local:ViewerText.HideWindowToTray}"
                            Style="{StaticResource QuietButtonStyle}" Click="HideButton_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,3">
                <TextBlock x:Name="StatusText" Text="{x:Static local:ViewerText.Loading}" FontSize="11"
                           Foreground="{StaticResource {x:Static local:ViewerBrushKeys.SecondaryTextBrush}}" TextTrimming="CharacterEllipsis"
                           ToolTip="{x:Static local:ViewerText.Loading}" Automation:AutomationProperties.LiveSetting="Polite" />
                <DockPanel Margin="0,1,0,0" LastChildFill="True">
                    <Button x:Name="SignInButton" Content="{x:Static local:ViewerText.SignInButton}" Visibility="Collapsed"
                            Style="{StaticResource SignInButtonStyle}" Margin="0,0,7,0"
                            Automation:AutomationProperties.Name="{x:Static local:ViewerText.SignInWithChatGpt}"
                            Click="SignInButton_Click" />
                    <TextBlock x:Name="UpdatedText" FontSize="10" Foreground="{StaticResource {x:Static local:ViewerBrushKeys.SecondaryTextBrush}}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="136" Focusable="True">
                <StackPanel x:Name="BucketPanel" />
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
